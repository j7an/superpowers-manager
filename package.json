{
  "name": "superpowers-manager",
  "version": "0.9.0",
  "description": "Install obra/superpowers directly from upstream for Codex, Pi, OpenCode, and Claude Code. Stay on a known-good release or commit, try a branch, and upgrade when you choose.",
  "keywords": [
    "superpowers",
    "obra-superpowers",
    "agent-skills",
    "skills",
    "ai-agent",
    "ai-coding-agent",
    "coding-agent",
    "agent-harness",
    "cli",
    "installer",
    "updater",
    "plugin-manager",
    "version-manager",
    "version-pinning",
    "codex",
    "openai-codex",
    "codex-plugin",
    "codex-skills",
    "pi",
    "pi-coding-agent",
    "pi-skills",
    "opencode",
    "opencode-plugin",
    "opencode-skills",
    "claude",
    "claude-code",
    "claude-code-plugin",
    "claude-code-skills"
  ],
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "prepack": "node --input-type=module -e \"console.error('error: use node tests/tools/pack.ts --out-dir <directory> to package this checkout');process.exitCode=1\"",
    "lint": "oxlint src/ tests/",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "test": "sh tests/run.sh",
    "test:harness:codex": "sh tests/container.sh harness-codex",
    "test:harness:pi": "sh tests/container.sh harness-pi",
    "test:harness:opencode": "sh tests/container.sh harness-opencode",
    "test:harness:claude-code": "sh tests/container.sh harness-claude-code",
    "test:acceptance": "sh tests/acceptance.sh",
    "check:static": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run knip",
    "check": "pnpm run check:static && pnpm run test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "knip": "^6.35.1",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j7an/superpowers-manager.git"
  },
  "homepage": "https://github.com/j7an/superpowers-manager#readme",
  "bugs": {
    "url": "https://github.com/j7an/superpowers-manager/issues"
  },
  "bin": {
    "superpowers-manager": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/",
    "config/upstream-ref",
    ".agents/plugins/marketplace.json",
    "plugins/superpowers/.codex-plugin/plugin.template.json",
    "README.md"
  ],
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.8.0"
  },
  "bundleDependencies": [
    "jsonc-parser",
    "smol-toml"
  ]
}
