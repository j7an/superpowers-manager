#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)
. "$root/scripts/core/common.sh"

if [ "$#" -gt 0 ]; then
  if ! (
    LC_ALL=C
    case "$1" in
      *[!\ -~]*) exit 1 ;;
    esac
  ); then
    echo "protocol strings must not contain terminal control characters" >&2
    exit 1
  fi
fi

spw_node_cli "$root" adapter-cli.js 'codex adapter' "$@"
